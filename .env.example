# Optional: Facebook app numeric ID → emits <meta property="fb:app_id" /> (Sharing Debugger “missing fb:app_id”).
# Create an app: https://developers.facebook.com/apps/ → Settings → Basic → App ID
NEXT_PUBLIC_FB_APP_ID=

# Payload admin. Required. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Local SQLite (default, free, gitignored). Ignored when POSTGRES_URL is set.
DATABASE_URI=file:./data/payload.db
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3010

# Production on Vercel Hobby (both have a free tier — no Payload Cloud required):
# 1. Vercel Marketplace → Neon Postgres → POSTGRES_URL
# 2. Vercel Storage → Blob → BLOB_READ_WRITE_TOKEN
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
